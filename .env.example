# riycol-agent 配置模板 — 复制为 .env 并填写
#
# === 必填 ===
# Telegram Bot Token (从 @BotFather 获取)
TELEGRAM_BOT_TOKEN=
# DeepSeek API Key (从 platform.deepseek.com 获取)
DEEPSEEK_API_KEY=
# DeepSeek API 地址 (默认官方)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# === 本地模型 ===
# 模型后端: ollama (推荐) | llama-cpp
LOCAL_MODEL_PROVIDER=ollama
# Ollama 地址
OLLAMA_URL=http://localhost:11434
# Ollama 模型 (当前: qwen3:8b)
OLLAMA_MODEL=qwen3:8b
# GGUF 模型路径 (仅 llama-cpp 模式)
MODEL_PATH=models/qwen2.5-1.5b.gguf
# 上下文大小 (tokens)
N_CTX=2048
# CPU 线程数
N_THREADS=8

# === 服务配置 ===
# HTTP 端口
PORT=8000
# 调试模式 (1=开启)
DEBUG=0
# HTTP API 鉴权 Key (留空=不鉴权)
API_KEY=

# === Telegram ===
# Telegram Bot 模型: deepseek | ollama | local | auto
TG_MODEL=auto
# 允许的用户 ID (逗号分隔，留空=不限制)
TELEGRAM_ALLOWED_USERS=
# 代理地址 (翻墙需要，格式: http://127.0.0.1:7890 或 socks5://127.0.0.1:1080)
TG_PROXY=

# === 知识库 ===
# 启用知识库 (1=启用, 0=禁用)
USE_KB=1
# 检索模式: keyword | vector | hybrid
KB_MODE=hybrid
# Embedding 模型 (vector/hybrid 模式)
EMBEDDING_MODEL=all-MiniLM-L6-v2
# ChromaDB 路径
VECTOR_KB_PATH=data/chroma_db

# === 对话配置 ===
# 启用数据库记录 (1=启用)
USE_DB=1
# 最大会话数 (LRU 驱逐)
MAX_CHAT_SESSIONS=500
# 上下文轮数
CONTEXT_ROUNDS=6

# === Agent ===
# 多模态投影模型路径
MMPROJ_PATH=
# HuggingFace 镜像 (国内加速)
HF_MIRROR=https://huggingface.co

# === 日志 ===
# 日志级别: debug | info | warn | error
LOG_LEVEL=info
